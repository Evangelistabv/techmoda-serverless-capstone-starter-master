{
  "name": "TechModa AI Capstone",

  // node:22 para que coincida con el Runtime nodejs22.x de las Lambdas CRUD.
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/aws-cli:1": {
      "version": "latest"
    },
    // 3.12 DEBE coincidir con el `Runtime: python3.12` de las Lambdas de IA.
    // Con 3.11 `sam build` falla con "PythonPipBuilder:Validation - Binary
    // validation failed for python ... did not satisfy constraints for runtime".
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",

  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "amazonwebservices.aws-toolkit-vscode",
        "ms-python.python",
        "redhat.vscode-yaml",
        "yzhang.markdown-all-in-one"
      ],
      "settings": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "files.exclude": {
          "**/.aws-sam": true,
          "**/node_modules": true
        }
      }
    }
  },

  "forwardPorts": [5173],

  "remoteUser": "node"
}
